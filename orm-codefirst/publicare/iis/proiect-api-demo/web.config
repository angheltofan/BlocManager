<?xml version="1.0" encoding="UTF-8"?>
<!--
  Site-ul IIS proiect-api-demo.com: aplicatia WebAPI (API-ul REST si sectiunea de utilizator).
  IIS primeste cererile pentru numele de host si le trimite, prin URL Rewrite + Application Request Routing,
  aplicatiei Node care asculta pe http://localhost:3002 (pornita de pm2).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Proxy catre aplicatia Node" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:3002/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <!-- raspunsurile de eroare ale aplicatiei (404, 400 JSON etc.) ajung neschimbate la client -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
