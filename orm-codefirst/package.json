{
  "name": "demo-orm-codefirst",
  "private": true,
  "description": "BlockManager - aplicatia finala: ORM Code First, nivelul Services, MVC (admin) si API (utilizator)",
  "type": "module",
  "workspaces": [
    "librarie-modele",
    "repository-codefirst",
    "nivel-acces-date",
    "servicii",
    "test-console-codefirst",
    "web-mvc",
    "web-api"
  ],
  "scripts": {
    "generate": "npm run generate -w repository-codefirst",
    "migrate:dev": "npm run migrate:dev -w repository-codefirst --",
    "migrate:status": "npm run migrate:status -w repository-codefirst",
    "db:seed": "npm run db:seed -w repository-codefirst",
    "start": "npm start -w test-console-codefirst",
    "typecheck": "tsc -p tsconfig.json",
    "web": "npm start -w web-mvc",
    "api": "npm start -w web-api",
    "migrate:deploy": "npm run migrate:deploy -w repository-codefirst",
    "admin": "npm start -w web-mvc"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
