# Echivalentul sectiunii connectionStrings din web.config: baza de date din Laboratorul 4
DATABASE_URL="postgresql://postgres:PAROLA_TA@localhost:5432/blockmanager_codefirst?schema=public"
INCARCARE_RELATII="eager"
# Portul API-ului
PORT=3002
# Adresa sectiunii de administrare (pentru legatura "Admin" din pagina utilizatorului)
ADRESA_ADMIN="http://localhost:3001"

# Laboratorul 10: durata de viata a serviciilor injectate (singleton, scoped sau transient)
DURATA_VIATA_SERVICII="singleton"
