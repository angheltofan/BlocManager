          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"cuponId\", pm.response.json().id);",
              "pm.collectionVariables.set(\"cuponCod\", pm.response.json().cod);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
