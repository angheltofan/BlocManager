{
  "info": {
    "_postman_id": "fca45701-47ef-46c8-8a94-7d6a675b6fac",
    "name": "BlockManager API - Cupoane (Laborator 7)",
    "description": "Endpoint-urile Get, Get(id), Post si Put pentru entitatea CuponReducere. Porneste API-ul cu `npm run api` din orm-codefirst, apoi ruleaza cererile in ordine (sau Run collection). Cererea 4 genereaza un cod nou la fiecare rulare (IARNA + un numar aleator), iar cererea 7 il modifica pe acela.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3002"
    },
    {
      "key": "cuponId",
      "value": "1"
    },
    {
      "key": "cuponCod",
      "value": "IARNA1"
    }
  ],
  "item": [
    {
      "name": "1. Get - toate cupoanele",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Lista de cupoane\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/cupoane",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cupoane"
          ]
        }
      }
    },
    {
      "name": "2. Get(id) - cuponul 3",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Cuponul MAX15\", () => pm.expect(pm.response.json().cod).to.eql(\"MAX15\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/cupoane/3",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cupoane",
            "3"
          ]
        }
      }
    },
    {
